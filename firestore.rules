rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.email == 'admin@viana.app'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      // Each user reads only their own record; the admin reads and lists everyone's.
      allow get:    if isOwner(uid) || isAdmin();
      allow list:   if isAdmin();
      // A user creates their own record when signing up (cannot make themselves admin).
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.get('isAdmin', false) == false);
      // A user updates only their own data and cannot re-enable a disabled account.
      allow update: if isAdmin() || (isOwner(uid)
                      && request.resource.data.get('isAdmin', false) == false
                      && request.resource.data.get('disabled', false) == resource.data.get('disabled', false));
      // Only the admin deletes users.
      allow delete: if isAdmin();
    }
  }
}
